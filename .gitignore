# 模型与数据（体积大，不入库）
models/pt/*
models/onnx/*
models/rknn/*
# 例外：RKNN 转换产物随代码发布 —— 板上部署直接用它，别人 clone 后也能
# 立刻验证/部署，不必先装 rknn-toolkit2 重转一遍。
# - yolov8n.rknn:     1.5.2 旧模型（Buildroot 时代，保留对照）
# - yolov8n_232.rknn: 2.3.2 新模型（Debian 12 / librknnrt 2.3.2）
# 两者都可由 models/onnx/yolov8n.onnx + calib/ + convert_to_rknn.py 重建。
!models/rknn/yolov8n.rknn
!models/rknn/yolov8n_232.rknn
!models/**/.gitkeep
data/datasets/*
data/recordings/*
data/downloads/*
!data/**/.gitkeep
# 实验结果：小的汇总结果（json/csv/md）入库，让文档里的数字可核对；
# 大文件（图、日志）仍忽略。注意 git 的限制：不能重新包含一个被排除目录里的文件，
# 所以结果文件要平铺在本目录下，不要建子目录。
experiments/results/*
!experiments/results/.gitkeep
!experiments/results/*.json
!experiments/results/*.csv
!experiments/results/*.md

# VM 共享目录：Windows ↔ Ubuntu 之间传文件用。
# 内容体积大且是本地产物，不入库；只保留说明和目录占位。
vm_share/to_vm/*
vm_share/from_vm/*
!vm_share/README.md
!vm_share/**/.gitkeep

# 板端部署包：wheel 和压缩包体积大，不入库
deploy/wheels/
deploy/pkg/
deploy/*.tar.gz

# 交接包：pkg/ 和 tar.gz 是生成物；源文件（README/edge_wire.h/脚本）入库
handoff/pkg/
handoff/*.tar.gz

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
